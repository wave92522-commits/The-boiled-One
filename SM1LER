local function normalize(res)
    if typeof(res) == "table" then
        local h = Instance.new("Model")
        for _, i in ipairs(res) do if typeof(i) == "Instance" then i.Parent = h end end
        return h
    elseif typeof(res) == "Instance" then
        if res:IsA("Model") then return res end
        local h = Instance.new("Model")
        res.Parent = h
        return h
    end
end

local function strip(model)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("LuaSourceContainer") or d:IsA("Humanoid") or d:IsA("Animator") or d:IsA("AnimationController")
            or d:IsA("Sound") or d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Constraint")
            or d:IsA("BodyMover") or d:IsA("ForceField") or d:IsA("ClickDetector") or d:IsA("ProximityPrompt")
            or d:IsA("BillboardGui") then
            pcall(function() d:Destroy() end)
        end
    end
end

local function buildFallback()
    local m = Instance.new("Model")
    local function part(name, size, cf, col, mat, sphere)
        local p = Instance.new("Part")
        p.Name, p.Size, p.CFrame, p.Color = name, size, cf, col
        p.Material = mat or Enum.Material.SmoothPlastic
        if sphere then
            local s = Instance.new("SpecialMesh")
            s.MeshType = Enum.MeshType.Sphere
            s.Parent = p
        end
        p.Parent = m
        return p
    end
    local black, flesh = Color3.fromRGB(8, 8, 10), Color3.fromRGB(160, 20, 20)
    part("Gown", Vector3.new(6.5, 7.8, 4.4), CFrame.new(0, 3.9, 0), black, Enum.Material.Fabric)
    part("Body", Vector3.new(4.5, 5.2, 2.8), CFrame.new(0, 10.2, 0), black, Enum.Material.Fabric)
    part("Head", Vector3.new(3.8, 4.8, 3.8), CFrame.new(0, 14.6, -0.2), flesh, nil, true)
    part("Mouth", Vector3.new(2.6, 2, 0.7), CFrame.new(0, 13.6, -1.9), Color3.fromRGB(10, 0, 0))
    for i = -3, 3 do
        part("Tooth", Vector3.new(0.22, 0.5, 0.22), CFrame.new(i * 0.33, 14.3, -2.1), boneColor())
    end
    for _, sx in ipairs({ -1, 1 }) do
        local nm = sx > 0 and "Right" or "Left"
        part(nm .. " UpperArm", Vector3.new(0.8, 5.5, 0.8), CFrame.new(sx * 3.6, 9.6, 0), black)
        part(nm .. " LowerArm", Vector3.new(0.65, 5.2, 0.65), CFrame.new(sx * 3.6, 4.5, -0.3), black)
        for k = -1, 1 do
            part(nm .. " Claw", Vector3.new(0.15, 2.4, 0.15), CFrame.new(sx * 3.6 + k * 0.3, 1, -0.4), Color3.fromRGB(70, 0, 0))

local function step(dt)
    local hum, hrp = S.humanoid, S.hrp
    if not (S.mounted and hum and hrp and hrp.Parent) then return end
    local t = os.clock()
    local v = hrp.AssemblyLinearVelocity
    local spd = Vector3.new(v.X, 0, v.Z).Magnitude
    S.walk += (((spd > 1.5) and 1 or 0) - S.walk) * math.min(1, dt * 8)
    local lk = hrp.CFrame.LookVector
    local fl = Vector3.new(lk.X, 0, lk.Z)
    if fl.Magnitude > 0.01 then S.flat = fl.Unit end
    local feet = hrp.Position - Vector3.new(0, feetOffset(), 0)
    local base = CFrame.lookAt(feet, feet + S.flat)
    local P = basePose(t)
    local at = t - S.atkStart
    if S.atk == "devour" then devourPose(at, P) elseif S.atk == "slam" then slamPose(at, P) end
    local sk = sink.Value
    local hsF = S.height / 15.5
    local bodyCF = base * CFrame.new(0, P.y * hsF - sk * (S.height + 3), P.z * hsF) * CFrame.Angles(P.pitch - sk * 0.6, 0, 0)
    local L = {}
    for sd, pv in pairs(S.limbs) do
        L[sd] = CFrame.new(pv) * CFrame.Angles(P.arm[sd] or 0, 0, P.roll[sd] or 0) * CFrame.new(-pv)
    end
    local Hc = CFrame.new(S.neck) * CFrame.Angles(P.head, 0, P.headRoll) * CFrame.new(-S.neck)
    local cfs, entries = S.cfs, S.entries
    for i = 1, #entries do
        local e = entries[i]
        local r = S.yawCF * e.rel
        if e.limb and L[e.limb] then r = L[e.limb] * r elseif e.head then r = Hc * r end
        cfs[i] = bodyCF * r
    end
    workspace:BulkMoveTo(S.parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
    S.mawWorld = bodyCF * (Hc * (S.headCenter + Vector3.new(0, -S.headR * 0.35, -S.headR * 0.95)))
    local g = S.grabSide
    local pv = S.limbs[g] or Vector3.new(g * S.height * 0.18, S.height * 0.72, 0)
    local len = S.armLen[g] or S.height * 0.35
    local Lg = L[g] or (CFrame.new(pv) * CFrame.Angles(P.arm[g], 0, 0) * CFrame.new(-pv))
    S.clawWorld = bodyCF * (Lg * (pv - Vector3.new(0, len, 0)))
    if S.atk then
        if S.atk == "devour" then updateDevour(at, t) else updateSlam(at) end
        if at >= S.atkDur then finishAttack() end
    end
    S.shake *= math.exp(-dt * 4)
    if S.shake < 0.01 then S.shake = 0 end
    hum.CameraOffset = S.camBase + Vector3.new(rnd(-1, 1) * S.shake, rnd(-1, 1) * S.shake, 0)
end

local function hideInst(d)
    if d:IsA("BasePart") or d:IsA("Decal") then
        if S.origTransp[d] == nil then S.origTransp[d] = d.Transparency end
        if d.Transparency ~= 1 then d.Transparency = 1 end
    end
end

local function heart()
    local hum, hrp = S.humanoid, S.hrp
    if not (S.mounted and hum and hrp and hrp.Parent) then return end
    local t = os.clock()
    local mul = 1
    if S.atk == "devour" and S.atkHas then mul = 0 elseif S.atk then mul = 0.3 end
    hum.WalkSpeed = (S.underground and CFG.DIG_SPEED or CFG.SPEED) * mul
    if S.underground ~= S.jumpLocked then
        S.jumpLocked = S.underground
        hum.JumpPower = S.underground and 0 or (S.origJump or 50)
    end
    if t > S.nextHide then
        S.nextHide = t + 0.5
        for _, d in ipairs(S.character:GetDescendants()) do hideInst(d) end
    end
    if S.underground then
        if sink.Value > 0.55 then
            mound.Transparency = 0
            mound.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - feetOffset() + math.sin(t * 9) * 0.1, hrp.Position.Z)
        end
        local pos = hrp.Position
        if not S.lastTrail or (pos - S.lastTrail).Magnitude > 2.5 then
            S.lastTrail = pos
            local g = groundAt(pos, 0, feetOffset() + 6)
            if g then
                puddle(g.Position, g.Normal, rnd(1, 2), 10, true)
                piece("dirt", g.Position + UP, Vector3.new(rnd(-6, 6), rnd(12, 22), rnd(-6, 6)), rnd(0.3, 0.8))
            end
        end
    elseif mound.Transparency < 1 then
        mound.Transparency = 1
    end
    if t < S.drool and t > S.nextDrip then
        S.nextDrip = t + 0.08
        piece("blood", S.mawWorld + Vector3.new(rnd(-0.4, 0.4), 0, rnd(-0.4, 0.4)), Vector3.new(rnd(-1, 1), -2, rnd(-1, 1)), rnd(0.18, 0.4))
    end
end


local victims = {}

local function getRoot(m)
    local r = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso")
    if r and r:IsA("BasePart") then return r end
    if m.PrimaryPart then return m.PrimaryPart end
    local head = m:FindFirstChild("Head")
    if head and head:IsA("BasePart") then return head end
    local best, bestVol = nil, 0
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("BasePart") then
            local vol = d.Size.X * d.Size.Y * d.Size.Z
            if vol > bestVol then best, bestVol = d, vol end
        end
    end
    return best
end

local LONG = { "dummy", "mannequin", "manikin", "zombie", "monster", "creature", "skeleton", "ghost", "villager",
    "civilian", "victim", "enemy", "robot", "animal", "demon", "ghoul", "citizen", "target", "guard", "soldier" }
local SHORT = { "npc", "mob", "bot", "boss", "bandit", "cop", "clone" }

local function nameAlive(m)
    local n = string.lower(m.Name)
    for _, w in ipairs(LONG) do if n:find(w, 1, true) then return true end end
    for _, w in ipairs(SHORT) do if n:find("%f[%a]" .. w .. "%f[%A]") then return true end end
    return false
end

local function isRig(m)
    if m:FindFirstChildOfClass("Humanoid") or m:FindFirstChildOfClass("AnimationController") then return true end
    if m:FindFirstChild("Head") and (m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("HumanoidRootPart")) then return true end
    return nameAlive(m)
end

local function validTarget(m)
    if victims[m] or not m.Parent then return nil end
    local ch = S.character
    if ch and (m == ch or m:IsDescendantOf(ch) or ch:IsDescendantOf(m)) then return nil end
    if m:IsDescendantOf(fx) then return nil end
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    local rig = hum ~= nil or isRig(m)
    if not (rig or CFG.KILL_PROPS) then return nil end
    local root = getRoot(m)
    if not root then return nil end
    local ok, size = pcall(function() return m:GetExtentsSize() end)
    if not ok then return nil end
    local maxDim = math.max(size.X, size.Y, size.Z)
    if maxDim > CFG.MAX_VICTIM_SIZE then return nil end
    if not rig and maxDim > 12 then return nil end
    return root
end

local function candidate(part)
    local m = part:FindFirstAncestorOfClass("Model")
    local nearest, firstRig = m, nil
    while m do
        if m:FindFirstChildOfClass("Humanoid") then return m end
        if not firstRig and isRig(m) then firstRig = m end
        m = m:FindFirstAncestorOfClass("Model")
    end
    if firstRig then return firstRig end
    if CFG.KILL_PROPS then return nearest end
    return nil
end

local function findTarget(range, center)
    local hrp = S.hrp
    if not hrp then return nil end
    center = center or (hrp.Position + S.flat * 5)
    local best, bestD, seen = nil, range + 3, {}
    local function consider(m)
        if not m or seen[m] then return end
        seen[m] = true
        local r = validTarget(m)
        if r then
            local d = (r.Position - center).Magnitude
            if d < bestD then best, bestD = m, d end
        end
    end
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { fx, S.character }
    for _, part in ipairs(workspace:GetPartBoundsInRadius(center, range, op)) do
        consider(candidate(part))
    end
    if not best then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.ClassName == "Humanoid" and d.Parent and d.Parent:IsA("Model") then consider(d.Parent) end
        end
    end
    return best
end


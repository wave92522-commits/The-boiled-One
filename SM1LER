        local kind = (roll < bone) and "bone" or ((roll < bone + flesh) and "flesh" or "blood")
        piece(kind, pos + Vector3.new(rnd(-1, 1), rnd(-0.5, 1), rnd(-1, 1)) * (o.jitter or 1),
            coneDir(dir, o.spread or 0.9) * rnd(o.vmin or 25, o.vmax or 70), rnd(o.smin or 0.6, o.smax or 1.8))
    end
end


local zc = 0
local function puddle(pos, n, radius, life, quick)
    zc = (zc + 1) % 60
    local p = disc(pos + n * (0.03 + zc * 0.003), n, 0.2, 0.2, 0.05, Color3.fromRGB(rng:NextInteger(90, 140), 0, rng:NextInteger(0, 8)))

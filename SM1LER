local function neonText(parent, text, font, w, h, pos, col, z)
    local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(w, h), Position = pos,
        AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z }, parent)
    local function layer(c, x, y, tr, zz)
        return new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(x, y),
            Font = font, Text = text, TextScaled = true, TextColor3 = c, TextTransparency = tr, ZIndex = zz }, holder)
    end
    local a = layer(CFG.B, -3, 0, 0.45, z)
    local b = layer(CFG.C, 3, 1, 0.45, z)
    local main = layer(col, 0, 0, 0, z + 1)
    new("UIStroke", { Color = col, Thickness = 2.5, Transparency = 0.5 }, main)
    return holder, main, a, b
end


local function loadTemplate()
    if template then return template end
    if loadingTpl then
        while loadingTpl do task.wait() end
        return template
    end
    loadingTpl = true
    local raw
    local pre = ReplicatedStorage:FindFirstChild("TheBoiledOne") or ReplicatedStorage:FindFirstChild("The Boiled One")
    if pre then raw = pre:Clone() end
    local url = "rbxassetid://" .. CFG.ASSET_ID
    local tries = {
        function() return game:GetObjects(url) end,
        function() return getobjects and getobjects(game, url) end,
        function() return InsertService:LoadLocalAsset(url) end,
        function() return InsertService:LoadAsset(CFG.ASSET_ID) end,
    }
    for _, f in ipairs(tries) do
        if raw then break end
        local ok, res = pcall(f)
        if ok and res then raw = normalize(res) end
    end
    if raw then
        strip(raw)
        local has = false
        for _, d in ipairs(raw:GetDescendants()) do
            if d:IsA("BasePart") then has = true break end
        end
        if not has then raw = nil end
    end
    if not raw then
        S.fallback = true
        raw = buildFallback()
    end
    template = raw
    loadingTpl = false
    return template
end

local function measure(parts, rot)
    local inv = rot:Inverse()
    local mn = Vector3.new(math.huge, math.huge, math.huge)
    local mx = -mn
    for pass = 1, 2 do
        local n = 0
        for _, p in ipairs(parts) do
            if pass == 2 or p.Transparency < 0.95 then
                n += 1
                local cf = inv * p.CFrame
                local hx, hy, hz = p.Size.X / 2, p.Size.Y / 2, p.Size.Z / 2
                local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
                local e = Vector3.new(
                    math.abs(r.X) * hx + math.abs(u.X) * hy + math.abs(l.X) * hz,
                    math.abs(r.Y) * hx + math.abs(u.Y) * hy + math.abs(l.Y) * hz,
                    math.abs(r.Z) * hx + math.abs(u.Z) * hy + math.abs(l.Z) * hz)
                mn = mn:Min(cf.Position - e)
                mx = mx:Max(cf.Position + e)
            end
        end
        if n > 0 then break end
    end
    return mn, mx
end

local function manualScale(parts, f)
    for _, p in ipairs(parts) do
        local cf = p.CFrame
        p.Size = p.Size * f
        p.CFrame = CFrame.new(cf.Position * f) * cf.Rotation
        for _, ch in ipairs(p:GetChildren()) do
            if ch:IsA("SpecialMesh") and ch.MeshType == Enum.MeshType.FileMesh then
                ch.Scale = ch.Scale * f
                ch.Offset = ch.Offset * f
            end
        end
    end
end

local function buildEntries(model)
    local parts = {}
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.Massless = true, false, false, false, true
            parts[#parts + 1] = d
        end
    end
    if #parts == 0 then return nil end
    local rr = model:FindFirstChild("HumanoidRootPart", true)
    local rot = (rr and rr:IsA("BasePart")) and rr.CFrame.Rotation or CFrame.new()
    local mn, mx = measure(parts, rot)
    local s = CFG.HEIGHT / math.max(mx.Y - mn.Y, 0.5)
    if not pcall(function() model:ScaleTo(model:GetScale() * s) end) then manualScale(parts, s) end
    mn, mx = measure(parts, rot)
    local h2 = mx.Y - mn.Y
    if h2 > 0.1 and math.abs(h2 - CFG.HEIGHT) > CFG.HEIGHT * 0.15 then
        manualScale(parts, CFG.HEIGHT / h2)
        mn, mx = measure(parts, rot)
    end
    local inv = (rot * CFrame.new((mn.X + mx.X) / 2, mn.Y, (mn.Z + mx.Z) / 2)):Inverse()
    local entries = {}
    for i, p in ipairs(parts) do entries[i] = { part = p, rel = inv * p.CFrame } end
    return entries, parts, math.max(mx.Y - mn.Y, 1)
end

local LIMB_W = { "arm", "claw", "hand", "finger", "nail", "wrist", "elbow" }
local HEAD_W = { "head", "face", "mouth", "jaw", "teeth", "tooth", "eye", "skull" }
local BAD_W = { "armor", "handle", "charm", "farm", "warm", "alarm", "harm" }

local function hasWord(n, list)
    n = string.lower(n)
    for _, w in ipairs(list) do if n:find(w, 1, true) then return true end end
    return false
end
local function isLimb(n) return hasWord(n, LIMB_W) and not hasWord(n, BAD_W) end

analyze = function()
    S.yaw = ((S.fallback and 0 or CFG.MODEL_YAW) + S.flip) % 360
    S.yawCF = CFrame.Angles(0, math.rad(S.yaw), 0)
    local h = S.height
    local minX, maxX = math.huge, -math.huge
    for _, e in ipairs(S.entries) do
        e.limb, e.head = nil, nil
        e.p0 = (S.yawCF * e.rel).Position
        minX, maxX = math.min(minX, e.p0.X), math.max(maxX, e.p0.X)
    end
    local width = math.max(maxX - minX, 1)
    local named = false
    for _, e in ipairs(S.entries) do
        if isLimb(e.part.Name) and e.p0.Y > h * 0.15 then named = true break end
    end
    local groups = {}
    for _, e in ipairs(S.entries) do
        local p = e.p0
        local ok
        if named then
            ok = isLimb(e.part.Name) and p.Y > h * 0.15
        else
            ok = math.abs(p.X) > width * 0.27 and p.Y > h * 0.12 and p.Y < h * 0.82
        end
        if ok and e.part.Name ~= "BOGlow" then
            local sd = p.X >= 0 and 1 or -1
            local g = groups[sd] or { top = -math.huge, bot = math.huge, sx = 0, sz = 0, n = 0 }
            groups[sd] = g
            e.limb = sd
            local half = e.part.Size.Y * 0.5
            g.top, g.bot = math.max(g.top, p.Y + half), math.min(g.bot, p.Y - half)
            g.sx += p.X
            g.sz += p.Z
            g.n += 1
        end
    end
    S.limbs, S.armLen = {}, {}
    for sd, g in pairs(groups) do
        local top = math.min(g.top, h * 0.86)
        S.limbs[sd] = Vector3.new(g.sx / g.n, top, g.sz / g.n)
        S.armLen[sd] = math.max(top - g.bot, h * 0.25)
    end
    S.grabSide = S.limbs[1] and 1 or (S.limbs[-1] and -1 or 1)
    local hn, hs, hmin, hnamed = 0, Vector3.zero, math.huge, false
    for _, e in ipairs(S.entries) do
        if not e.limb and hasWord(e.part.Name, HEAD_W) and e.p0.Y > h * 0.55 then hnamed = true break end
    end
    for _, e in ipairs(S.entries) do
        if not e.limb then
            local ok
            if hnamed then ok = hasWord(e.part.Name, HEAD_W) and e.p0.Y > h * 0.55 else ok = e.p0.Y > h * 0.8 end
            if ok then
                e.head = true
                hn += 1
                hs += e.p0
                hmin = math.min(hmin, e.p0.Y - e.part.Size.Y * 0.5)
            end
        end
    end
    if hn > 0 then
        S.headCenter = hs / hn
        S.neck = Vector3.new(S.headCenter.X, math.max(hmin, h * 0.6), S.headCenter.Z)
        S.headR = math.max(S.headCenter.Y - S.neck.Y, 1)
    else
        S.headCenter, S.neck, S.headR = Vector3.new(0, h * 0.88, 0), Vector3.new(0, h * 0.78, 0), h * 0.08
    end
    S.drip = {}
    for _, e in ipairs(S.entries) do
        if e.part.Transparency < 0.9 and e.p0.Y > h * 0.25 and e.p0.Y < h * 0.8 then
            S.drip[#S.drip + 1] = e
        end
    end
end

local function basePose(t)
    local P = { pitch = 0, y = 0, z = 0, head = 0, headRoll = 0, arm = { [1] = 0, [-1] = 0 }, roll = { [1] = 0, [-1] = 0 } }
    local w = S.walk
    for _, sd in ipairs({ 1, -1 }) do
        local idleA = 0.1 + math.sin(t * 1.25 + sd * 0.7) * 0.09 + math.sin(t * 3.3 + sd * 1.9) * 0.028 + math.sin(t * 7.1 + sd) * 0.008
        local tch = math.noise(t * 1.6, sd * 3.1, 0.5)
        if tch > 0.3 then idleA += (tch - 0.3) * 1.5 end
        local idleR = sd * (0.1 + math.sin(t * 0.85 + sd) * 0.05 + math.sin(t * 5.3 + sd * 2) * 0.012)
        P.arm[sd] = lerp(idleA, -0.42, w)
        P.roll[sd] = lerp(idleR, sd * 0.2, w)
    end
    P.head = (math.sin(t * 0.6) * 0.035 + math.max(0, math.noise(t * 0.9, 7.7) - 0.3) * 0.5) * (1 - w)
    P.headRoll = math.sin(t * 0.45) * 0.03 * (1 - w)
    P.pitch = -0.06 * w
    return P
end

local function devourPose(at, P)
    local g, o = S.grabSide, -S.grabSide
    if S.atkHas then
        if at < 0.30 then
            local k = easeOut(at / 0.30)
            P.arm[g] = lerp(P.arm[g], 1.55, k)
            P.roll[g] = lerp(P.roll[g], -g * 0.15, k)
            P.z, P.pitch, P.head = -2.6 * k, -0.22 * k, 0.1 * k
        elseif at < 0.85 then
            local k = smooth((at - 0.30) / 0.55)
            P.arm[g] = lerp(1.55, 2.95, k)
            P.roll[g] = -g * 0.15 * (1 - k)
            P.z, P.pitch, P.y, P.head = lerp(-2.6, 0, k), lerp(-0.22, 0.16, k), 0.7 * k, lerp(0.1, 0.3, k)
        elseif at < 1.10 then
            local k = smooth((at - 0.85) / 0.25)
            P.arm[g] = 2.95 + math.sin(at * 45) * 0.05
            P.pitch, P.y, P.head = 0.16, 0.7, lerp(0.3, 0.7, k)
        elseif at < 1.55 then
            local k = easeOut((at - 1.10) / 0.14)
            P.arm[g] = lerp(2.95, 2.2, k)
            P.pitch, P.y, P.head = 0.18, 0.7, 0.72 + math.sin(at * 30) * 0.03
        elseif at < 1.64 then
            local k = easeIn((at - 1.55) / 0.09)
            P.arm[g] = lerp(2.2, 1.3, k)
            P.head, P.pitch, P.y = lerp(0.72, -0.4, k), lerp(0.18, -0.22, k), lerp(0.7, 0.2, k)
        elseif at < 2.30 then
            local c = at - 1.64
            P.arm[g] = lerp(1.3, 0.6, smooth(c / 0.66))
            P.head = -0.12 + math.sin(c * 19) * 0.2
            P.pitch, P.y = -0.1 + math.sin(c * 19) * 0.04, 0.2
        else
            local k = smooth((at - 2.30) / 0.45)
            P.arm[g] = lerp(0.6, P.arm[g], k)
            P.head, P.pitch, P.y = lerp(-0.12, P.head, k), lerp(-0.1, P.pitch, k), lerp(0.2, 0, k)
        end
        local ko = smooth(at / 0.8) * (1 - smooth((at - 2.3) / 0.45))
        P.arm[o] = lerp(P.arm[o], 0.9 + math.sin(at * 6) * 0.08, ko)
        P.roll[o] = lerp(P.roll[o], o * 0.55, ko)
    else
        if at < 0.34 then
            local k = easeOut(at / 0.34)
            P.arm[g], P.arm[o] = lerp(P.arm[g], 1.7, k), lerp(P.arm[o], 1.1, k)
            P.z, P.pitch, P.head = -3.2 * k, -0.25 * k, 0.2 * k
        elseif at < 0.48 then
            local k = easeIn((at - 0.34) / 0.14)
            P.arm[g], P.arm[o] = lerp(1.7, 1.0, k), lerp(1.1, 0.7, k)
            P.z, P.pitch, P.head = -3.2, -0.25, lerp(0.2, -0.2, k)
        else
            local k = smooth((at - 0.48) / 0.8)
            P.arm[g], P.arm[o] = lerp(1.0, P.arm[g], k), lerp(0.7, P.arm[o], k)
            P.z, P.pitch, P.head = lerp(-3.2, 0, k), lerp(-0.25, 0, k), lerp(-0.2, 0, k)
        end
    end
end

local function slamPose(at, P)
    if at < 0.62 then
        local k = smooth(at / 0.62)
        for _, sd in ipairs({ 1, -1 }) do
            P.arm[sd] = lerp(P.arm[sd], 3.0, k)
            P.roll[sd] = lerp(P.roll[sd], sd * 0.25, k)
        end
        P.pitch, P.y, P.head, P.z = 0.2 * k, 0.8 * k, 0.3 * k, 0.8 * k
    elseif at < 0.80 then
        local k = easeIn((at - 0.62) / 0.18)
        for _, sd in ipairs({ 1, -1 }) do
            P.arm[sd] = lerp(3.0, -0.15, k)
            P.roll[sd] = lerp(sd * 0.25, sd * 0.05, k)
        end
        P.pitch, P.y, P.z, P.head = lerp(0.2, -0.38, k), lerp(0.8, -0.7, k), lerp(0.8, -3.6, k), lerp(0.3, -0.25, k)
    elseif at < 0.95 then
        for _, sd in ipairs({ 1, -1 }) do P.arm[sd], P.roll[sd] = -0.15, sd * 0.05 end
        P.pitch, P.y, P.z, P.head = -0.38, -0.7, -3.6, -0.25
    else
        local k = smooth((at - 0.95) / 0.75)
        for _, sd in ipairs({ 1, -1 }) do
            P.arm[sd] = lerp(-0.15, P.arm[sd], k)
            P.roll[sd] = lerp(sd * 0.05, P.roll[sd], k)
        end
        P.pitch, P.y, P.z, P.head = lerp(-0.38, P.pitch, k), lerp(-0.7, 0, k), lerp(-3.6, 0, k), lerp(-0.25, P.head, k)
    end
end


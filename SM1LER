local function mount()
    if S.mounted or S.busy then return end
    S.busy = true
    local model = loadTemplate():Clone()
    local entries, parts, h = buildEntries(model)
    if not entries then S.busy = false return end
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not (hum and hrp) then S.busy = false return end
    local lp = Instance.new("Part")
    lp.Name = "BOGlow"
    lp.Size = Vector3.new(0.2, 0.2, 0.2)
    lp.Transparency = 1
    lp.Anchored, lp.CanCollide, lp.CanQuery, lp.CanTouch = true, false, false, false
    lp.Parent = model
    local pl = Instance.new("PointLight")
    pl.Color, pl.Range, pl.Brightness = Color3.fromRGB(255, 30, 50), 26, 1.6
    pl.Parent = lp
    entries[#entries + 1] = { part = lp, rel = CFrame.new(0, h * 0.65, -0.6) }
    parts[#parts + 1] = lp
    S.character, S.humanoid, S.hrp = char, hum, hrp
    S.entries, S.parts, S.height, S.model, S.cfs = entries, parts, h, model, {}
    S.origWalk, S.origJump, S.origDisplay = hum.WalkSpeed, hum.JumpPower, hum.DisplayDistanceType
    S.origMin, S.origMax = player.CameraMinZoomDistance, player.CameraMaxZoomDistance
    S.underground, S.atk, S.jumpLocked = false, nil, false
    refilter()
    analyze()
    for _, d in ipairs(char:GetDescendants()) do hideInst(d) end
    mt(char.DescendantAdded:Connect(function(d) task.defer(hideInst, d) end))
    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    S.camBase = Vector3.new(0, math.max(0, (h - 5) * 0.5), 0)
    pcall(function()
        player.CameraMinZoomDistance = h * 0.65
        player.CameraMaxZoomDistance = math.max(S.origMax, h * 3.5)
    end)
    tint = Instance.new("ColorCorrectionEffect")
    tint.TintColor = Color3.fromRGB(255, 225, 225)
    tint.Saturation = -0.15
    tint.Contrast = 0.12
    tint.Parent = Lighting
    savedLight = { Ambient = Lighting.Ambient, FogColor = Lighting.FogColor, FogEnd = Lighting.FogEnd }
    Lighting.Ambient = Lighting.Ambient:Lerp(Color3.fromRGB(60, 0, 10), 0.5)
    Lighting.FogColor = Color3.fromRGB(20, 0, 5)
    Lighting.FogEnd = math.min(Lighting.FogEnd, 650)
    sink.Value = 1
    model.Name = "BOMorph"
    model.Parent = fx
    S.mounted = true
    step(0.016)
    mt(RunService.RenderStepped:Connect(step))
    mt(RunService.Heartbeat:Connect(heart))
    mt(hum.Died:Connect(function() if S.atk then finishAttack() end end))
    tw(sink, 0.9, { Value = 0 }, Enum.EasingStyle.Back)
    task.delay(0.2, function()
        if not S.mounted then return end
        local feet = hrp.Position - Vector3.new(0, feetOffset(), 0)
        carnage(feet + UP, UP, 70, { spread = 0.85, vmin = 30, vmax = 85 })
        for _ = 1, 30 do
            piece("dirt", feet + UP, coneDir(UP, 0.9) * rnd(20, 55), rnd(0.4, 1.1))
        end
        mist(feet + UP * 3, 60, 11)
        ring(feet, UP, 26, CFG.A, 0.7)
        ring(feet, UP, 18, CFG.C, 0.6)
        flashLight(feet + UP * 4, CFG.A, 8, 40, 0.8)
        puddle(feet, UP, 9, 40, false)
        S.shake = 2.2
        impactTint(0.8)
        sfx("roar", 2.4, 0.8)
        sfx("scare", 1.6, 1)
    end)
    S.busy = false
end

local function unmount()
    if not S.mounted then return end
    if S.atk then finishAttack() end
    S.mounted = false
    for _, c in ipairs(mConns) do pcall(function() c:Disconnect() end) end
    mConns = {}
    for inst, v in pairs(S.origTransp) do
        pcall(function() if inst.Parent then inst.Transparency = v end end)
    end
    S.origTransp = setmetatable({}, { __mode = "k" })
    local hum = S.humanoid
    if hum and hum.Parent then
        pcall(function()
            hum.WalkSpeed = S.origWalk or 16
            hum.JumpPower = S.origJump or 50
            hum.CameraOffset = Vector3.zero
            hum.DisplayDistanceType = S.origDisplay or Enum.HumanoidDisplayDistanceType.Viewer
        end)
    end
    pcall(function()
        player.CameraMinZoomDistance = S.origMin or 0.5
        player.CameraMaxZoomDistance = S.origMax or 128
    end)
    if S.model then S.model:Destroy() S.model = nil end
    if tint then tint:Destroy() tint = nil end
    if savedLight then
        for k, v in pairs(savedLight) do pcall(function() Lighting[k] = v end) end
        savedLight = nil
    end
    mound.Transparency = 1
    S.underground = false
    sink.Value = 0
end

